# ==============================================================================
# PayPal FinOps Copilot — Environment Configuration Template
# ==============================================================================

# Application & Server
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-key-in-production
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-encoded-key-for-aes-256-gcm

# Database (PostgreSQL 15)
POSTGRES_USER=finops_user
POSTGRES_PASSWORD=finops_password
POSTGRES_DB=finops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finops_user:finops_password@localhost:5432/finops_db
# For Docker network: postgresql+asyncpg://finops_user:finops_password@postgres:5432/finops_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# PayPal Sandbox Credentials (https://developer.paypal.com/dashboard/)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_registered_webhook_id_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Human-in-the-Loop (HITL) Policy Engine Defaults
HITL_AUTO_SUBMIT_AMOUNT_THRESHOLD=50.00
HITL_MIN_CONFIDENCE_SCORE=0.85

