# ==============================================================================
# PayPal FinOps Copilot - Global .gitignore
# ==============================================================================

# Node.js / Frontend dependencies & builds
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python virtual environments & interpreters
.venv/
venv/
ENV/
env/
.Python
*.egg-info/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml

# Local SQLite databases & state
*.db
*.sqlite
*.sqlite3
finops_copilot.db

# Environment configuration & secrets (always keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
*.log
logs/

# Operating System & IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archive packages
*.zip
*.tar.gz
*.rar
*.7z
