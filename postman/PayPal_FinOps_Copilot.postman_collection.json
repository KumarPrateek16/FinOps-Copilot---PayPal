        },
        {
          "name": "Submit HITL Decision (Approve / Concede)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE_SUBMISSION\",\n  \"reviewer_notes\": \"Verified by operations manager. FedEx tracking confirms on-time delivery with recipient signature.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/disputes/{{disputeId}}/hitl/action",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disputes", "{{disputeId}}", "hitl", "action"]
            }
          }
        }
